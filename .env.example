# ---- Server ----
ENV=development                 # development | production
PORT=8080
API_URL=http://localhost:8080   # public URL of this API (OAuth callbacks)
APP_URL=http://localhost:3000   # web frontend (share links, post-login redirect)
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
# postgres://user:pass@host:5432/vaulty?sslmode=disable  |  sqlite://vaulty.db
DATABASE_URL=sqlite://vaulty.db

# ---- Sessions ----
JWT_SECRET=                     # >= 32 chars, required in production (openssl rand -base64 48)
SESSION_TTL=24h

# ---- Secret storage ----
# awssm = AWS Secrets Manager + KMS (production) | local = AES-GCM in the DB (dev only)
VAULT_DRIVER=local
LOCAL_VAULT_KEY=                # base64 32 bytes; dev auto-generates .vaulty-local.key
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=                 # platform CMK (id, ARN or alias/...); empty = aws/secretsmanager
AWS_SECRET_PREFIX=vaulty
AWS_SECRET_FORCE_DELETE=false   # true = delete immediately, false = recovery window
AWS_SECRET_RECOVERY_DAYS=7
AWS_ENABLED=false               # enable AWS connection verification while using VAULT_DRIVER=local

# ---- OAuth providers (enabled when client id + secret are set) ----
# Callback URL to register at each provider: {API_URL}/api/v1/auth/oauth/{provider}/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITLAB_CLIENT_ID=
OAUTH_GITLAB_CLIENT_SECRET=
OAUTH_GITLAB_URL=https://gitlab.com
# Generic OAuth 2.0 / OIDC (Okta, Auth0, Keycloak, Azure AD...)
OAUTH_OIDC_NAME=oidc
OAUTH_OIDC_CLIENT_ID=
OAUTH_OIDC_CLIENT_SECRET=
OAUTH_OIDC_AUTH_URL=
OAUTH_OIDC_TOKEN_URL=
OAUTH_OIDC_USERINFO_URL=
OAUTH_OIDC_SCOPES=openid,email,profile
